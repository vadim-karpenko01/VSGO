# Environment Variables Template
# Copy this file to .env.local and fill in your values

# API Root URL - Backend API endpoint
API_ROOT=http://localhost:8000
SECRET_KEY=1234567890-secret

# Gallery / site admin mock login (frontend only; replace with Supabase Auth later)
NEXT_PUBLIC_GALLERY_ADMIN_EMAIL=vadim@vsgo.local
NEXT_PUBLIC_GALLERY_ADMIN_PASSWORD=vadim-gallery

# Supabase (documents PDF table + Storage bucket `documents`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional site URL for Open Graph / canonical
# NEXT_PUBLIC_BASE_URL=https://vsgo.vercel.app
